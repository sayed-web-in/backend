# Copy to .env and fill in values (never commit .env)

# Prisma — MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

PORT=4000

# Comma-separated browser origins (Vite / Next dev servers)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5000

# JWT secret for admin/auth APIs
JWT_SECRET=your-jwt-secret-change-in-production

# Optional: prisma db seed — default admin (override in production)
# ADMIN_EMAIL=admin@futuretechnology.local
# ADMIN_PASSWORD=Admin@123456
# ADMIN_NAME=Super Admin

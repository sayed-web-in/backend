generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      UserRole @default(ADMIN)
  avatar    String?
  isActive  Boolean  @default(true)
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String
  email        String?
  phone        String
  address      String?   @db.Text
  division     String?
  district     String?
  totalAdvance Decimal   @default(0) @db.Decimal(12, 2)
  googleId     String?   @unique
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  sales        Sale[]

  @@map("customers")
}

// ─── BRANCH ──────────────────────────────────────────────────

model Branch {
  id             Int              @id @default(autoincrement())
  name           String
  address        String?          @db.Text
  phone          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  users          User[]
  storeProducts  StoreProduct[]
  sales          Sale[]
  purchases      Purchase[]
  stockAdjustments StockAdjustment[]
  transfersFrom  StockTransfer[]  @relation("TransferFrom")
  transfersTo    StockTransfer[]  @relation("TransferTo")
  categories     CategoryBranch[]
  brands         BrandBranch[]

  @@map("branches")
}

// ─── CATEGORY & SUBCATEGORY ──────────────────────────────────

model Category {
  id            Int              @id @default(autoincrement())
  name          String
  image         String?
  description   String?          @db.Text
  displayOrder  Int              @default(0)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subcategories SubCategory[]
  products      Product[]
  branches      CategoryBranch[]

  @@map("categories")
}

model CategoryBranch {
  id         Int      @id @default(autoincrement())
  categoryId Int
  branchId   Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([categoryId, branchId])
  @@map("category_branches")
}

model SubCategory {
  id          Int       @id @default(autoincrement())
  name        String
  image       String?
  description String?   @db.Text
  categoryId  Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]

  @@map("sub_categories")
}

// ─── BRAND ───────────────────────────────────────────────────

model Brand {
  id          Int           @id @default(autoincrement())
  name        String
  image       String?
  description String?       @db.Text
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]
  branches    BrandBranch[]

  @@map("brands")
}

model BrandBranch {
  id       Int    @id @default(autoincrement())
  brandId  Int
  branchId Int
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([brandId, branchId])
  @@map("brand_branches")
}

// ─── UNIT ────────────────────────────────────────────────────

model Unit {
  id        Int       @id @default(autoincrement())
  name      String
  shortName String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("units")
}

// ─── ATTRIBUTES & VARIANTS ──────────────────────────────────

model Attribute {
  id        Int              @id @default(autoincrement())
  name      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          Int                       @id @default(autoincrement())
  value       String
  attributeId Int
  attribute   Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  variants    ProductVariantAttribute[]

  @@map("attribute_values")
}

// ─── PRODUCT ─────────────────────────────────────────────────

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  slug          String           @unique
  type          ProductType      @default(SINGLE)
  sku           String?          @unique
  categoryId    Int?
  subCategoryId Int?
  brandId       Int?
  unitId        Int?
  taxRateId     Int?
  hasImei       Boolean          @default(false)
  description   String?          @db.LongText
  status        ProductStatus    @default(DRAFT)
  isBestDeal    Boolean          @default(false)
  isFeatured    Boolean          @default(false)
  isArchived    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  category      Category?        @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  brand         Brand?           @relation(fields: [brandId], references: [id])
  unit          Unit?            @relation(fields: [unitId], references: [id])
  taxRate       TaxRate?         @relation(fields: [taxRateId], references: [id])
  images        ProductImage[]
  specifications Specification[]
  variants      ProductVariant[]
  storeProducts StoreProduct[]

  @@map("products")
}

enum ProductType {
  SINGLE
  VARIABLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Specification {
  id        Int     @id @default(autoincrement())
  name      String
  value     String  @db.Text
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("specifications")
}

model ProductVariant {
  id            Int                       @id @default(autoincrement())
  sku           String                    @unique
  image         String?
  productId     Int
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  attributes    ProductVariantAttribute[]
  storeProducts StoreProduct[]

  @@map("product_variants")
}

model ProductVariantAttribute {
  id               Int            @id @default(autoincrement())
  productVariantId Int
  attributeValueId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, attributeValueId])
  @@map("product_variant_attributes")
}

// ─── STORE PRODUCT & BATCH ──────────────────────────────────

model StoreProduct {
  id               Int             @id @default(autoincrement())
  productId        Int
  productVariantId Int?
  branchId         Int
  quantity         Int             @default(0)
  sellingPrice     Decimal         @db.Decimal(12, 2)
  discountType     DiscountType?
  discountValue    Decimal?        @db.Decimal(12, 2)
  quantityAlert    Int             @default(5)
  sellingType      SellingType     @default(BOTH)
  isBestDeal       Boolean         @default(false)
  isFeatured       Boolean         @default(false)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  branch           Branch          @relation(fields: [branchId], references: [id])
  batches          Batch[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  orderItems       OrderItem[]

  @@map("store_products")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum SellingType {
  ONLINE
  STORE
  BOTH
}

model Batch {
  id            Int            @id @default(autoincrement())
  batchNumber   String         @unique
  barcode       String?        @unique
  batchType     String         @default("initial")
  initialQty    Int
  availableQty  Int
  soldQty       Int            @default(0)
  returnQty     Int            @default(0)
  purchaseCost  Decimal        @db.Decimal(12, 2)
  totalCost     Decimal        @db.Decimal(12, 2)
  supplierId    Int?
  storeProductId Int
  batchDate     DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  storeProduct  StoreProduct   @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  serialNumbers SerialNumber[]

  @@map("batches")
}

model SerialNumber {
  id        Int          @id @default(autoincrement())
  serial    String       @unique
  status    SerialStatus @default(IN_STOCK)
  batchId   Int
  saleItemId Int?
  batch     Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  saleItem  SaleItem?    @relation(fields: [saleItemId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("serial_numbers")
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  TRANSFERRED
}

// ─── SUPPLIER ────────────────────────────────────────────────

model Supplier {
  id          Int              @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  company     String?
  address     String?          @db.Text
  totalDue    Decimal          @default(0) @db.Decimal(12, 2)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  batches     Batch[]
  purchases   Purchase[]

  @@map("suppliers")
}

// ─── SALES ───────────────────────────────────────────────────

model Sale {
  id              Int          @id @default(autoincrement())
  invoiceNumber   String       @unique
  customerId      Int?
  branchId        Int
  totalAmount     Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  tax             Decimal      @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal      @db.Decimal(12, 2)
  paidAmount      Decimal      @db.Decimal(12, 2)
  changeAmount    Decimal      @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal      @default(0) @db.Decimal(12, 2)
  paymentMethod   String       @default("cash")
  paymentAccountId Int?
  status          SaleStatus   @default(COMPLETED)
  note            String?      @db.Text
  orderId         Int?         @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customer        Customer?    @relation(fields: [customerId], references: [id])
  branch          Branch       @relation(fields: [branchId], references: [id])
  paymentAccount  Account?     @relation(fields: [paymentAccountId], references: [id])
  order           Order?       @relation(fields: [orderId], references: [id])
  items           SaleItem[]
  returns         SaleReturn[]

  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PAY_LATER
  RETURNED
  PARTIAL_RETURN
}

model SaleItem {
  id             Int            @id @default(autoincrement())
  saleId         Int
  storeProductId Int
  quantity       Int
  unitPrice      Decimal        @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  storeProduct   StoreProduct   @relation(fields: [storeProductId], references: [id])
  serialNumbers  SerialNumber[]

  @@map("sale_items")
}

model SaleReturn {
  id         Int                @id @default(autoincrement())
  saleId     Int
  reason     String?            @db.Text
  totalAmount Decimal           @db.Decimal(12, 2)
  createdAt  DateTime           @default(now())
  sale       Sale               @relation(fields: [saleId], references: [id])
  items      SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id           Int        @id @default(autoincrement())
  saleReturnId Int
  storeProductId Int
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@map("sale_return_items")
}

// ─── PURCHASES ───────────────────────────────────────────────

model Purchase {
  id              Int              @id @default(autoincrement())
  referenceNo     String           @unique
  supplierId      Int?
  branchId        Int
  totalAmount     Decimal          @db.Decimal(12, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  tax             Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal          @db.Decimal(12, 2)
  paidAmount      Decimal          @db.Decimal(12, 2)
  dueAmount       Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod   String           @default("cash")
  paymentAccountId Int?
  status          PurchaseStatus   @default(RECEIVED)
  note            String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  paymentAccount  Account?         @relation(fields: [paymentAccountId], references: [id])
  items           PurchaseItem[]
  returns         PurchaseReturn[]

  @@map("purchases")
}

enum PurchaseStatus {
  RECEIVED
  PARTIAL
  PENDING
  RETURNED
}

model PurchaseItem {
  id             Int          @id @default(autoincrement())
  purchaseId     Int
  storeProductId Int
  quantity       Int
  unitCost       Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  purchase       Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id])

  @@map("purchase_items")
}

model PurchaseReturn {
  id          Int                  @id @default(autoincrement())
  purchaseId  Int
  reason      String?              @db.Text
  totalAmount Decimal              @db.Decimal(12, 2)
  createdAt   DateTime             @default(now())
  purchase    Purchase             @relation(fields: [purchaseId], references: [id])
  items       PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  storeProductId   Int
  quantity         Int
  unitCost         Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

// ─── ORDERS (FRONTEND) ──────────────────────────────────────

model Order {
  id            Int            @id @default(autoincrement())
  orderNumber   String         @unique
  customerId    Int
  name          String
  phone         String
  division      String
  district      String
  address       String         @db.Text
  totalAmount   Decimal        @db.Decimal(12, 2)
  status        OrderStatus    @default(PENDING)
  paymentMethod String         @default("cod")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      Customer       @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  tracking      OrderTracking[]
  sale          Sale?

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id             Int          @id @default(autoincrement())
  orderId        Int
  storeProductId Int
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id])

  @@map("order_items")
}

model OrderTracking {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String
  note      String?  @db.Text
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_tracking")
}

// ─── STOCK ───────────────────────────────────────────────────

model StockAdjustment {
  id             Int              @id @default(autoincrement())
  type           AdjustmentType
  reason         String?          @db.Text
  branchId       Int
  createdAt      DateTime         @default(now())
  branch         Branch           @relation(fields: [branchId], references: [id])
  items          StockAdjustmentItem[]

  @@map("stock_adjustments")
}

enum AdjustmentType {
  ADDITION
  SUBTRACTION
}

model StockAdjustmentItem {
  id                Int             @id @default(autoincrement())
  stockAdjustmentId Int
  storeProductId    Int
  quantity          Int
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)

  @@map("stock_adjustment_items")
}

model StockTransfer {
  id             Int                 @id @default(autoincrement())
  fromBranchId   Int
  toBranchId     Int
  status         TransferStatus      @default(PENDING)
  note           String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  fromBranch     Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch       Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  items          StockTransferItem[]

  @@map("stock_transfers")
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model StockTransferItem {
  id              Int           @id @default(autoincrement())
  stockTransferId Int
  storeProductId  Int
  quantity        Int
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

// ─── FINANCE & ACCOUNTS ─────────────────────────────────────

model Account {
  id           Int           @id @default(autoincrement())
  name         String
  accountNumber String?
  type         AccountType
  balance      Decimal       @default(0) @db.Decimal(14, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  sales        Sale[]
  purchases    Purchase[]

  @@map("accounts")
}

enum AccountType {
  CASH
  BANK
  MOBILE_BANKING
}

model Transaction {
  id          Int             @id @default(autoincrement())
  accountId   Int
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  reference   String?
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  account     Account         @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
}

model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id         Int             @id @default(autoincrement())
  categoryId Int
  accountId  Int?
  amount     Decimal         @db.Decimal(12, 2)
  note       String?         @db.Text
  date       DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

model IncomeCategory {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  incomes   Income[]

  @@map("income_categories")
}

model Income {
  id         Int            @id @default(autoincrement())
  categoryId Int
  accountId  Int?
  amount     Decimal        @db.Decimal(12, 2)
  note       String?        @db.Text
  date       DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  category   IncomeCategory @relation(fields: [categoryId], references: [id])

  @@map("incomes")
}

model TaxRate {
  id        Int       @id @default(autoincrement())
  name      String
  rate      Decimal   @db.Decimal(5, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("tax_rates")
}

// ─── SERVICE ─────────────────────────────────────────────────

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal  @db.Decimal(12, 2)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

// ─── CONTENT (BANNERS, ARTICLES) ────────────────────────────

model Banner {
  id        Int        @id @default(autoincrement())
  title     String?
  image     String
  link      String?
  type      BannerType
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("banners")
}

enum BannerType {
  HERO_LARGE
  HERO_SMALL
  MIDDLE_LEFT
  MIDDLE_RIGHT
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  image     String?
  content   String   @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

// ─── SETTINGS ────────────────────────────────────────────────

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("settings")
}
